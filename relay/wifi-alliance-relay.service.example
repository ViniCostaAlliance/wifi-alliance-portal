[Unit]
Description=Alliance Wi-Fi UniFi authorization relay
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=wifi-portal
WorkingDirectory=/opt/wifi-alliance/relay
EnvironmentFile=/etc/wifi-alliance-relay.env
ExecStart=/usr/bin/node /opt/wifi-alliance/relay/dist/server.js
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
